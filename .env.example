# Puerto para el servidor HTTP REST API
HTTP_PORT=3000

# Puerto para el servidor WebSocket
WS_PORT=8080

# Orígenes permitidos para CORS (separados por coma)
# Usa * para permitir todos los orígenes (solo desarrollo)
ALLOWED_ORIGINS=http://localhost:9000,http://localhost:3001,http://localhost:4200,http://localhost:8000

# Credenciales mock (puedes cambiarlas según tu necesidad)
MOCK_CLIENT_ID=MOCK_CLIENT_ID
MOCK_CLIENT_SECRET=MOCK_CLIENT_SECRET
MOCK_USER_IDENTITY=test@example.com

# Token JWT mock
MOCK_JWT_TOKEN=mock_jwt_token_12345

# ID del bot mock
MOCK_BOT_ID=mock_bot_id

# Configuración de validación
# true = valida credenciales, false = acepta cualquiera
VALIDATE_CREDENTIALS=false

# true = requiere JWT token, false = más permisivo
REQUIRE_JWT=false

# true = validación estricta, false = validación relajada
STRICT_MODE=false
